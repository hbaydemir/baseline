{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Baseline",
  "version": "../package.json",
  "identifier": "net.baydemir.baseline",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1430", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build && npm run build:tools" },
  "app": {
    "windows": [{ "label": "main", "title": "Baseline", "width": 1360, "height": 860, "minWidth": 1000, "minHeight": 620, "dragDropEnabled": false, "backgroundColor": "#f7f9fb" }],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com data:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:" }
  },
  "bundle": {
    "active": true, "fileAssociations": [{ "ext": ["baseline"], "name": "Baseline belgesi" }], "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../dist-tools/mcp.mjs": "ai/mcp.mjs", "../dist-tools/cli.mjs": "ai/cli.mjs", "../dist-tools/manifold.wasm": "ai/manifold.wasm", "../dist-tools/font.ttf": "ai/font.ttf", "../library/": "library/" },
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Turkish", "English"] } }
  }
}
